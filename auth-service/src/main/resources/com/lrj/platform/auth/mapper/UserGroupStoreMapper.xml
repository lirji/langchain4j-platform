<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.platform.auth.mapper.UserGroupStoreMapper">
    <select id="readInit1" resultType="com.lrj.platform.auth.mapper.UserGroupStoreRow">
        SELECT USERNAME, GROUP_NAME, CREATED_AT FROM USER_GROUP WHERE 1=0
    </select>
    <select id="readGroupsOf1" resultType="java.lang.String">
        SELECT GROUP_NAME FROM USER_GROUP WHERE USERNAME=#{username} ORDER BY GROUP_NAME
    </select>
    <select id="readMembersOf1" resultType="java.lang.String">
        SELECT USERNAME FROM USER_GROUP WHERE GROUP_NAME=#{groupName} ORDER BY USERNAME
    </select>
    <delete id="writeReplaceGroupsForUser1">
        DELETE FROM USER_GROUP WHERE USERNAME=#{username}
    </delete>
    <delete id="writeReplaceMembersForGroup1">
        DELETE FROM USER_GROUP WHERE GROUP_NAME=#{groupName}
    </delete>
    <delete id="writeRemoveAllForUser1">
        DELETE FROM USER_GROUP WHERE USERNAME=#{username}
    </delete>
    <delete id="writeRemoveAllForGroup1">
        DELETE FROM USER_GROUP WHERE GROUP_NAME=#{groupName}
    </delete>
    <insert id="writeInsertIfAbsent1">
        INSERT INTO USER_GROUP (USERNAME, GROUP_NAME, CREATED_AT) VALUES (#{username}, #{groupName}, #{createdAt})
    </insert>
</mapper>
