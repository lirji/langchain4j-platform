# 本文件只放非敏感配置示例；复制为 deploy/.env 后，把路径改为本机百炼凭据 CSV。
# API Key 由 load-bailian-env.sh 运行时读取，禁止直接写入 .env 或提交仓库。
BAILIAN_CREDENTIAL_CSV=/absolute/path/to/bailian-credentials.csv

RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_MAX_SEGMENTS_PER_BATCH=10
RAG_VECTOR_STORE_BASE_COLLECTION=knowledge_segments_bailian_v4

RAG_RERANK_ENABLED=true
RAG_RERANK_TYPE=bailian
RAG_RERANK_BAILIAN_MODEL=qwen3-rerank

# LiteLLM model 字段包含 provider 前缀；可换 openai/qwen3-vl-flash 等目录中存在的视觉模型。
BAILIAN_VISION_MODEL=openai/qwen3-vl-plus
# 启动前只读查询百炼 /models，确认凭据有效且目标模型存在；不发推理请求。
BAILIAN_MODEL_PREFLIGHT=true
VISION_ENABLED=true
VISION_MODEL=vision-default

# 同一百炼业务空间的原生语音与跨模态向量能力；Key 仍由 CSV 运行时注入。
VOICE_ENABLED=true
VOICE_PROVIDER=bailian
VOICE_ASR_MODEL=qwen3-asr-flash
VOICE_TTS_MODEL=qwen3-tts-flash
VOICE_TTS_VOICE=Cherry
VOICE_TTS_FORMAT=wav
VOICE_LANGUAGE=zh

RAG_MULTIMODAL_ENABLED=true
RAG_MULTIMODAL_PROVIDER=bailian
RAG_MULTIMODAL_MODEL=qwen3-vl-embedding
RAG_MULTIMODAL_DIMENSION=1024
RAG_MULTIMODAL_BASE_COLLECTION=knowledge_images_bailian_qwen3vl

# AgentScope 是 Agent 全量默认目标；宿主机调试端口默认 18085。
AGENTSCOPE_IMAGE=agentscope-platform:local
AGENTSCOPE_HOST_PORT=18085
EDGE_AGENT_BASELINE_BACKEND=agentscope

# 候选版本灰度（默认关闭）。候选需先以 AGENT_V2_ENABLED=true 启用 /agent/v2/run。
# 只填明确批准的测试租户；逗号分隔。空列表即使 enabled=true 也保持静态 AgentScope 基线。
EDGE_AGENT_CANARY_ENABLED=false
EDGE_AGENT_CANARY_URI=http://agentscope-orchestrator:8085
EDGE_AGENT_CANARY_TENANTS=
